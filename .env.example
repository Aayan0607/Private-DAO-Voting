# Local demo: binds to your own disposable Hardhat chain. No real wallet needed.
ENABLE_LOCAL_DEMO=false
# Production/testnet configuration (leave unset for local mode).
# APP_ORIGIN=https://your-voting-app.example
# VOTING_RPC_URL=https://your-testnet-rpc.example
# VOTING_CHAIN_ID=91562037
# VOTING_CONTRACT_ADDRESS=0x...
# RELAYER_PRIVATE_KEY=...
# VOTING_DATA_DIR=/persistent/path/to/public-snapshots
# Never prefix server credentials with NEXT_PUBLIC_. Identity secrets are never server configuration.
